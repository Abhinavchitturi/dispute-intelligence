# ResolveIQ Environment Configuration Example
# Copy this file to .env and configure values as needed.

# Application Mode: "demo" or "sandbox"
RESOLVEIQ_MODE=demo

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///./resolveiq.db

# PayPal Sandbox Credentials (Required only for PayPal Sandbox Mode)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=
# Sandbox mode only: seconds between automatic pulls of new disputes from PayPal (0 = off)
PAYPAL_POLL_SECONDS=10

# AI Provider Configuration (Optional - falls back to deterministic independent verification engine if unset)
# Set AI_PROVIDER to "gemini" or "openai", or "none" for rules engine fallback
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI Configuration (Kept securely on backend, never exposed to frontend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Security / Token Secret for internal session/local use
SECRET_KEY=change-this-in-production-use-a-secure-random-token
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://localhost:8001,http://127.0.0.1:8001

# --- Sign-in, oversight and email ---
# Sign-in is required. Set to false only for local scripts and tests.
AUTH_REQUIRED=true
TOKEN_TTL_HOURS=12
# The AI reviewer (built separately) calls /api/ai-agent/* with this key in the X-AI-Agent-Key header. Leave empty to refuse it.
AI_AGENT_API_KEY=
# The mail provider forwards replies to the appeals address to POST /api/inbound-mail with this secret in X-Inbound-Secret.
INBOUND_MAIL_SECRET=
# An investigator gets a strike each time the AI reviewer overturns them.
# Every NOTIFY strikes the managers are alerted (and pinged hourly until sorted). At BLOCK strikes the account is blocked.
# Every case has this many days. The score climbs as the deadline nears, and a case nobody has taken by its deadline goes to the AI Agent.
CASE_WINDOW_DAYS=5
AI_AGENT_NAME=AI Agent
# High-profile cases (the manager takes these): any case for this amount or more. Price only, since a priority score keeps changing.
HIGH_PROFILE_AMOUNT=1000
STRIKE_NOTIFY_THRESHOLD=3
STRIKE_BLOCK_THRESHOLD=10
ALERT_REMINDER_MINUTES=60
# Email. With no SMTP_HOST, emails are kept in the app (Case > Emails) instead of being sent.
APPEALS_EMAIL=appeals@resolveiq.example
MAIL_FROM=disputes@resolveiq.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Simulate seller/buyer replies on PayPal sandbox cases (their test accounts never really answer)
SIMULATE_REPLIES=true

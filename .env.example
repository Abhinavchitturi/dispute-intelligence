# ResolveIQ Environment Configuration Example
# Copy this file to .env and configure values as needed.

# Application Mode: "demo" or "sandbox"
RESOLVEIQ_MODE=demo

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///./resolveiq.db

# PayPal Sandbox Credentials (Required only for PayPal Sandbox Mode)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=

# AI Provider Configuration (Optional - falling back to deterministic investigation brief generator if unset)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

# Security / Token Secret for internal session/local use
SECRET_KEY=change-this-in-production-use-a-secure-random-token
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
